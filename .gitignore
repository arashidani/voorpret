# --- 依存とビルド成果物 ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# --- シークレット・環境変数 ---
# フロント用（VITE_LIFF_ID など）
.env
.env.*
!.env.example
# Worker用のローカルシークレット（LINE_CHANNEL_ID など）
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local

# --- Cloudflare / Wrangler ---
