.wrangler/

# --- ログ ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- テスト・カバレッジ ---
coverage/
playwright-report/
test-results/

# --- エディタ・OS ---
.vscode/*
